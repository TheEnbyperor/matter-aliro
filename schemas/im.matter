im => PROTOCOL [ id 0x0000:0x0001 ] {
	ClusterPathIB => LIST {
		Node [0] : UNSIGNED INTEGER [ range 64-bits ] { 0..1 },
		Endpoint [1] : UNSIGNED INTEGER [ range 16-bits ],
		Cluster [2] : UNSIGNED INTEGER [ range 32-bits ],
	}

	AttributePathIB => LIST {
		EnableTagCompression [0] : BOOLEAN { 0..1 },
		Node [1] : UNSIGNED INTEGER [ range 64-bits ] { 0..1 },
		Endpoint [2] : UNSIGNED INTEGER [ range 16-bits ] { 0..1 },
		Cluster [3] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		Attribute [4] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		ListIndex [5] : UNSIGNED INTEGER [ range 16-bits, nullable ] { 0..1 },
		WildcardPathFlags [6]: UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		WildcardFilterConfigurationVersion [7]: UNSIGNED INTEGER [ range 32-bits ] { 0..1 }
	}

	EventPathIB => LIST {
		Node [0] : UNSIGNED INTEGER [ range 64-bits ] { 0..1 },
		Endpoint [1] : UNSIGNED INTEGER [ range 16-bits ] { 0..1 },
		Cluster [2] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		Event [3] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		IsUrgent [4] : BOOLEAN { 0..1 },
	}

	CommandPathIB => LIST {
		Endpoint [0] : UNSIGNED INTEGER [ range 16-bits ] { 0..1 },
		Cluster [1] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 },
		Command [2] : UNSIGNED INTEGER [ range 32-bits ] { 0..1 }
	}

	EventFilterIB => STRUCTURE [ tag-order ] {
		Node [0, optional] : UNSIGNED INTEGER [ range 64-bits ],
		EventMin [1] : UNSIGNED INTEGER [ range 64-bits ]
	}

	DataVersionFilterIB => STRUCTURE [ tag-order ] {
		Path [0] : ClusterPathIB,
		DataVersion [1] : UNSIGNED INTEGER [ range 32-bits ]
	}

	AttributeDataIB => STRUCTURE [ tag-order ] {
		DataVersion [0, optional] : UNSIGNED INTEGER [ range 32-bits ],
		Path [1] : AttributePathIB,
		Data [2] : ANY
	}

	EventDataIB => STRUCTURE [ tag-order ] {
		Path [0] : EventPathIB,
		EventNumber [1] : UNSIGNED INTEGER [ range 64-bits ],
		Priority [2] : UNSIGNED INTEGER [ range 8-bits ],
		EpochTimestamp [3, optional] : UNSIGNED INTEGER [ range 64-bits ],
		SystemTimestamp [4, optional] : UNSIGNED INTEGER [ range 64-bits ],
		DeltaEpochTimestamp [5, optional] : UNSIGNED INTEGER [ range 64-bits ],
		DeltaSystemTimestamp [6, optional] : UNSIGNED INTEGER [ range 64-bits ],
		Data [7] : ANY
	}

	StatusIB => STRUCTURE [ tag-order ] {
		Status [0] : UNSIGNED INTEGER [ range 8-bits ],
		ClusterStatus [1] : UNSIGNED INTEGER [ range 8-bits ]
	}

	AttributeStatusIB => STRUCTURE [ tag-order ] {
		Path [0] : AttributePathIB,
		Status [1] : StatusIB
	}

	EventStatusIB => STRUCTURE [ tag-order ] {
		Path [0] : EventPathIB,
		Status [1] : StatusIB
	}

	CommandStatusIB => STRUCTURE [ tag-order ] {
		Path [0] : CommandPathIB,
		Status [1] : StatusIB,
		CommandRef [2, optional] : UNSIGNED INTEGER [ range 16-bits ]
	}

	AttributeReportIB => STRUCTURE [ tag-order ] {
		AttributeStatus [0, optional] : AttributeStatusIB,
		AttributeData [1, optional] : AttributeDataIB
	}

	EventReportIB => STRUCTURE [ tag-order ] {
		EventStatus [0, optional] : EventStatusIB,
		EventData [1, optional] : EventDataIB
	}

	CommandDataIB => STRUCTURE [ tag-order ] {
		CommandPath [0] : CommandPathIB,
		CommandFields [1, optional] : ANY,
		CommandRef [2, optional] : UNSIGNED INTEGER [ range 16-bits ]
	}

	InvokeResponseIB => STRUCTURE [ tag-order ] {
		Command [0, optional] : CommandDataIB,
		Status [1, optional] : CommandStatusIB
	}

	StatusResponseMessage => STRUCTURE [ tag-order ] {
		Status [0] : UNSIGNED INTEGER [ range 8-bits ],
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	ReadRequestMessage => STRUCTURE [ tag-order ] {
		AttributeRequests [0, optional] : ARRAY OF AttributePathIB,
		EventRequests [1, optional] : ARRAY OF EventPathIB,
		EventFilters [2, optional] : ARRAY OF EventFilterIB,
		FabricFiltered [3] : BOOLEAN,
		DataVersionFilters [4, optional] : ARRAY OF DataVersionFilterIB,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	ReportDataMessage => STRUCTURE [ tag-order ] {
		SubscriptionID [0, optional] : UNSIGNED INTEGER [ range 32-bits ],
		AttributeReports [1, optional] : ARRAY OF AttributeReportIB,
		EventReports [2, optional] : ARRAY OF EventReportIB,
		MoreChunkedMessages [3, optional] : BOOLEAN,
		SuppressResponse [4, optional] : BOOLEAN,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	SubscribeRequestMessage => STRUCTURE [ tag-order ] {
		KeepSubscriptions [0] : BOOLEAN,
		MinIntervalFloor [1] : UNSIGNED INTEGER [ range 16-bits ],
		MaxIntervalCeiling [2] : UNSIGNED INTEGER [ range 16-bits ],
		AttributeRequests [3, optional] : ARRAY OF AttributePathIB,
		EventRequests [4, optional] : ARRAY OF EventPathIB,
		EventFilters [5, optional] : ARRAY OF EventFilterIB,
		FabricFiltered [7] : BOOLEAN,
		DataVersionFilters [8, optional] : ARRAY OF DataVersionFilterIB,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	SubscribeResponseMessage => STRUCTURE [ tag-order ] {
		SubscriptionID [0] : UNSIGNED INTEGER [ range 32-bits ],
		MaxInterval [2] : UNSIGNED INTEGER [ range 16-bits ],
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	WriteRequestMessage => STRUCTURE [ tag-order ] {
		SuppressResponse [0, optional] : BOOLEAN,
		TimedRequest [1] : BOOLEAN,
		WriteRequests [2] : ARRAY OF AttributeDataIB,
		MoreChunkedMessages [3, optional] : BOOLEAN,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	WriteResponseMessage => STRUCTURE [ tag-order ] {
		WriteResponses [0] : ARRAY OF AttributeStatusIB,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	InvokeRequestMessage => STRUCTURE [ tag-order ] {
		SuppressResponse [0] : BOOLEAN,
		TimedRequest [1] : BOOLEAN,
		InvokeRequests [2] : ARRAY OF CommandDataIB,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	InvokeResponseMessage => STRUCTURE [ tag-order ] {
		SuppressResponse [0] : BOOLEAN,
		InvokeResponses [1] : ARRAY OF InvokeResponseIB,
		MoreChunkedMessages [2] : BOOLEAN,
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}

	TimedRequestMessage => STRUCTURE [ tag-order ] {
		Timeout [0] : UNSIGNED INTEGER [ range 16-bits ],
		InteractionModelRevision [255] : UNSIGNED INTEGER [ range 8-bits ]
	}
}